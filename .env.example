# ─── Database (Railway) ────────────────────────────────────────
# DATABASE_URL         gennem PgBouncer. Bruges af Vercel-frontenden.
#                      Railway: PgBouncer-servicens offentlige TCP-proxy.
# DATABASE_URL_DIRECT  direkte paa Postgres. Bruges af workeren og af
#                      drizzle-kit. Railway: det private domaene,
#                      fx postgres.railway.internal:5432
#
# Migrationer skal altid koere paa DATABASE_URL_DIRECT.
DATABASE_URL=
DATABASE_URL_DIRECT=

# ─── Billed-proxy ──────────────────────────────────────────────
# HMAC i stien, sa proxyen ikke kan bruges af fremmede.
IMGPROXY_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=

# ─── Crawler ───────────────────────────────────────────────────
# Bofinda praesenterer sig altid. Ingen falsk User-Agent.
CRAWLER_USER_AGENT=BofindaBot/1.0 (+https://bofinda.dk/bot; kontakt@bofinda.dk)
CRAWLER_RATE_MS=1000

# ─── Kommer i fase 3-4 ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
