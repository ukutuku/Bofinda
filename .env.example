# Postgres. Virker med bade Neon og Supabase — det er bare en connection string.
# Beslutningen mellem dem kan udskydes, sa laenge alt gar gennem DATABASE_URL.
DATABASE_URL=

# Billed-proxy. HMAC i stien, sa proxyen ikke kan bruges af fremmede.
IMGPROXY_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=

# Crawler-identitet. Bofinda praesenterer sig altid.
CRAWLER_USER_AGENT=BofindaBot/1.0 (+https://bofinda.dk/bot; kontakt@bofinda.dk)
CRAWLER_RATE_MS=1000

# Kommer i fase 3-4
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
