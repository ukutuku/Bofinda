# ─── Database (Supabase) ───────────────────────────────────────
# Begge findes under Project Settings → Database → Connection string.
#
# DATABASE_URL         Transaction pooler, port 6543.
#                      Til Next.js paa Vercel. prepare: false er paakraevet.
#                      aws-0-<region>.pooler.supabase.com:6543
#
# DATABASE_URL_DIRECT  Session pooler eller direct connection, port 5432.
#                      Til migrationer og til scraper-workeren.
#                      Direct (db.<ref>.supabase.co:5432) er IPv6-only paa
#                      nye projekter — virker din maskine eller Railway ikke
#                      paa IPv6, saa brug session pooleren paa port 5432
#                      i stedet. Begge kan holde en session, som DDL kraever.
DATABASE_URL=
DATABASE_URL_DIRECT=

# ─── Supabase Auth ─────────────────────────────────────────────
# Erstatter den auth, briefen lagde i fase 0.
# Kun den offentlige publishable-noegle maa naa browseren.
# Secret-noeglen (tidl. service_role) maa ALDRIG i frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Billed-proxy ──────────────────────────────────────────────
# Signerer /api/billede. Skal vaere ens i alle miljoeer.
# Lav en ny med:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ── KOERESEDDEL: ROTÉR DEN I DENNE RAEKKEFOELGE ───────────────────
#  signer() er HMAC over `${url}|${bredde}` (lib/billede.ts:128) — intet
#  deploy-id, ingen version. En rotation skifter derfor HVER billed-URL paa
#  én gang, browser- og CDN-cache bliver irrelevante, og hvert distinkt
#  billede hentes igen fra kilderne.
#
#  Det realistiske tilfaelde er det vaerste: man roterer FORDI
#  hemmeligheden er laekket — hurtigt, under pres. Derfor staar trinnene
#  her og ikke kun en advarsel.
#
#  1. SAET TAKTEN NED FOERST, paa de fire vaerter der rammes ad BEGGE veje:
#     dacas.dk · findbolig.nu · birchejendomme.dk · alabubolig.dk
#     (VAERTSTAKT i lib/fetch.ts). Billedproxyen er upacet, saa det er det
#     eneste, der daemper crawlen, mens genhentningen loeber.
#  2. ROTÉR, og saet den samme vaerdi i ALLE miljoeer i samme ombaering.
#     HVIS DU GLEMMER ÉT MILJOE, SER DET SAADAN UD: nogle billeder vises,
#     andre ikke, paa samme side — og det skifter, naar man genindlaeser.
#     Ruten svarer 403 «ugyldig signatur» paa dem, det gamle miljoe
#     signerede. **Det ligner et cacheproblem**, og det foerste man
#     proever, er at toemme cachen — hvilket gaetter paa det forkerte og
#     tilfoejer en ny runde genhentning oven i den, der allerede loeber.
#     Tjek i stedet, at hemmeligheden er ENS: samme vaerdi, alle miljoeer.
#  3. VARM CACHEN I ETAPER frem for at lade brugerne goere det. Hent
#     forsidens og de nyeste boligers billeder foerst, i den takt du satte
#     i trin 1. Lader man brugerne varme den, er det dem, der venter, og
#     kilderne, der rammes samtidigt.
#  4. SAET TAKTEN TILBAGE, naar genhentningen er ovre.
#
#  HVORNAAR ER DEN OVRE? Det kan man ikke se i dag, og det er en mangel:
#  /api/billede logger ingenting (ingen maaling, ingen taeller). Det
#  eneste observerbare er Vercels egen kantcache-statistik, som ligger
#  uden for repoet. Loftet for antal kald er antallet af DISTINKTE
#  billeder paa aktive boliger:
#
#      psql "$DATABASE_URL_DIRECT" -f scripts/maal-billedloft.sql
#
#  KEND TALLET FOER TRIN 2, saa der er noget at holde statistikken op mod.
#  Et loft uden en taeller er bedre end en taeller uden et loft: man kan
#  se, hvornaar tallet MAA vaere naaet.
BILLED_HEMMELIGHED=

# ─── Adressevask ───────────────────────────────────────────────
# simpel  Deterministisk INTERN noegle af postnr+vej+husnr(+etage+doer).
#         Ikke et officielt DAR-UUID, men stabil og god nok til dedup.
#         Noeglerne er praefikset 'intern:v1:' saa de kan udskiftes praecist.
# dar     Officielt opslag i Datafordeleren. Ikke implementeret endnu.
ADDRESS_WASHER=simpel

# ─── Crawler ───────────────────────────────────────────────────
CRAWLER_USER_AGENT=BofindaBot/1.0 (+https://bofinda.dk/bot; kontakt@bofinda.dk)
CRAWLER_RATE_MS=1000

# ─── Kommer i fase 3-4 ─────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ─── Alarmmails (Resend) ───────────────────────────────────────
RESEND_API_KEY=
# Afsender. Domaenet skal vaere verificeret i Resend.
ALARM_AFSENDER=Bofinda <alarm@bofinda.dk>
# INDKOERINGSVENTIL: kun disse adresser faar mail. Kommasepareret.
# Er den tom, sendes der til alle — saet den, indtil du har set, hvad der
# faktisk lander i indbakken.
ALARM_TILLADTE_MODTAGERE=
# Bruges i mailens links. Skal vaere den rigtige adresse i produktion.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Balders soegenoegle. Ligger i deres eget offentlige frontend-bundt paa
# www.balder.dk og bruges dér efter Balders egen anvisning — ikke gravet
# ud paa egen haand. Se docs/kildetilladelser.md.
BALDER_API_KEY=

# ─── Produktanalytics ──────────────────────────────────────────
# TÆNDKNAPPEN. Uden 1 skrives der ingenting overhovedet — heller ikke
# selv om koden er deployet og brugeren har sagt ja til statistik.
# Aktiveringen er en bevidst handling i Vercel-panelet, saa maalingen
# ikke gaar live, bare fordi en deploy gik igennem. Kan slukkes igen
# uden en deploy.
MAALING_AKTIV=
# Andelen af samtykkende sessioner, der bidrager med listing_impression.
# 0-100, standard 25. Stikproeven er deterministisk PR. SESSION: en
# session er enten fuldt med eller helt ude, aldrig delvist.
# Se docs/analytics-v1.md afsnit 7.
MAALING_IMPRESSION_PCT=25
