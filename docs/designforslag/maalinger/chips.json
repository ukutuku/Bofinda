  "3b_produktion_fra_repoet": {
    "maalt_daekning_af_move_in_cost": "FINDES IKKE i repoet. docs/supply-baseline-2026-09-06.md:3-11 måler depositum og forudbetalt (0 % i alle kilder undtagen native), ikke move_in_cost. Propstep og LokalBolig regner move_in_cost af depositum/forudbetalt, de læser men ikke gemmer (app/bolig/[id]/page.tsx:88-92), så 0 % depositum er ikke 0 % indflytningspris. docs/designforslag/README.md:381 nævner «80 % af kortene» uden at sige, hvilken base.",
    "saetter_move_in_cost": {
      "propstep": "adapters/propstep.ts:204-209 (kun når husleje, depositum og forudbetalt kendes)",
      "lokalbolig": "adapters/lokalbolig.ts:200-204 (samme betingelse)",
      "findbolig": "adapters/findbolig.ts:205-210 (husleje, måneder depositum/forudbetalt og aconto)",
      "balder": "adapters/balder.ts:115-119 (kildens combined_upfront_payment)",
      "dacas": "adapters/dacas.ts:219-220 (kildens Indflytningspris)",
      "heimstaden": "adapters/heimstaden.ts:172-177 (kildens Indflytningspris, når den findes)",
      "laros": "adapters/laros.ts:159",
      "native": "lib/udlejer.ts:100-108 (kun med depositum og forudbetalt)"
    },
    "saetter_aldrig_move_in_cost": {
      "home": "adapters/home.ts:24-26",
      "cej": "adapters/cej.ts:320-323 (gemmer delene, ikke summen)",
      "birch": "adapters/birch.ts:121-124 (kun depositum)",
      "alabu": "adapters/alabu.ts:28-30"
    },
    "hvornaar_nul_opstaar": "Altid ved kildefilter på home.dk, CEJ, Birch eller Alabu; i områder, hvor kun de fire har boliger (home.dk: 228 synlige, 169 i kbh+frb, 58 i storkbh — supply-baseline linje 6); og hvor de betingede adaptere mangler et led. Hyppigheden kan ikke måles herfra. maal.mjs --prod gør det (kun select)."
  },
