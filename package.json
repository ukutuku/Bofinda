{
  "name": "bofinda",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./certs/rapidssl-tls-rsa-ca-g1.pem next dev",
    "build": "NODE_EXTRA_CA_CERTS=./certs/rapidssl-tls-rsa-ca-g1.pem next build",
    "start": "NODE_EXTRA_CA_CERTS=./certs/rapidssl-tls-rsa-ca-g1.pem next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "import": "NODE_EXTRA_CA_CERTS=./certs/rapidssl-tls-rsa-ca-g1.pem tsx --env-file-if-exists=.env scripts/import.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:tables": "node --env-file-if-exists=.env scripts/tables.mjs",
    "worker": "NODE_EXTRA_CA_CERTS=./certs/rapidssl-tls-rsa-ca-g1.pem tsx --env-file-if-exists=.env scripts/worker.ts",
    "puls": "node --env-file-if-exists=.env scripts/puls.mjs",
    "alarm": "tsx --env-file-if-exists=.env scripts/alarm.ts",
    "genparse": "tsx --env-file-if-exists=.env scripts/genparse-adresser.ts",
    "db:status": "node --env-file-if-exists=.env scripts/migrationer.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "drizzle-orm": "^0.38.0",
    "leaflet": "^1.9.4",
    "next": "^15.0.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "dotenv": "^16.4.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
